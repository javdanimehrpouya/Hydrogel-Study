            "dataset and the glass-adhesion endpoint. Repeated validations "
            "reuse the same training observations; acquisition groups "
            "are snapshot proxies; bootstrap intervals are conditional "
            "and omit refitting.</p>"
        ),
    ]

    for name, caption in figure_list:
        escaped_caption = html.escape(caption)
        body.append(
            f"<h2>{escaped_caption}</h2>"
            f'<img src="figures/{name}.png" '
            f'alt="{escaped_caption}">'
        )

    (ROOT / "report.html").write_text(
        "\n".join(body) + "</html>",
        encoding="utf-8",
    )


# ============================================================
# Entry point
# ============================================================

def main():
    global ROOT, OUT

    parser = argparse.ArgumentParser(description=__doc__)

    parser.add_argument(
        "--output",
        default="hydrogel_outputs",
    )
    parser.add_argument(
        "--skip-extra",
        action="store_true",
        help="Skip repeated/group/bootstrap diagnostics.",
    )
    parser.add_argument(
        "--plots-only",
        action="store_true",
        help="Regenerate figures from completed output tables.",
    )

    args = parser.parse_args()

    ROOT = Path(args.output).expanduser().resolve()
    OUT = ROOT / "results" / "review_diagnostics"

    for folder in ["data", "results", "models", "figures"]:
        (ROOT / folder).mkdir(
            parents=True,
            exist_ok=True,
        )

    if not args.plots_only:
        if args.skip_extra and OUT.exists():
            raise RuntimeError(
                "Use a fresh --output directory with --skip-extra "
                "to avoid mixing previous diagnostics with a new run."
            )

        prepare_data()
        run_study()

        if not args.skip_extra:
            run_additional()

    make_figures()

    print("Outputs:", ROOT, flush=True)
    print("Open:", ROOT / "report.html", flush=True)


if __name__ == "__main__":
    # Keep the custom estimator importable when loading saved models.
    sys.modules["hydrogel_study"] = sys.modules[__name__]
    AugmentedRegressor.__module__ = "hydrogel_study"

    main()
