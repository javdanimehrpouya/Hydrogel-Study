def run_additional():
    OUT.mkdir(parents=True, exist_ok=True)
    start = time.time()

    train = pd.read_csv(ROOT / "data/train_real_272.csv")
    test = pd.read_csv(ROOT / "data/test_real_69.csv")

    X = train[FEATURES].to_numpy(float)
    y = train[TARGET].to_numpy(float)

    assert set(train.formulation_id).isdisjoint(test.formulation_id)

    # Reuse the original repeat rather than changing its recorded results.
    old = pd.read_csv(ROOT / "results/cv_oof_predictions.csv")
    old = old[old.scenario.isin(MAIN)].copy()
    old["repeat_seed"] = 2026

    predictions = old.to_dict("records")
    parameters = []

    for seed in [2027, 2028, 2029, 2030]:
        outer = KFold(
            n_splits=5,
            shuffle=True,
            random_state=seed,
        )

        for fold, (tr, va) in enumerate(outer.split(X), start=1):
            for name in NAMES:
                for scenario, sigma in zip(MAIN, [None, 0.03]):
                    model, settings = tune(
                        name,
                        X[tr],
                        y[tr],
                        seed + fold,
                        sigma,
                    )

                    p = model.predict(X[va])

                    parameters.append({
                        "repeat_seed": seed,
                        "fold": fold,
                        "model": name,
                        "scenario": scenario,
                        "parameters": settings,
                    })

                    predictions.extend(
                        {
                            "repeat_seed": seed,
                            "fold": fold,
                            "model": name,
                            "scenario": scenario,
                            "formulation_id": train.iloc[i].formulation_id,
                            "actual": float(actual),
                            "predicted": float(predicted),
                        }
                        for i, actual, predicted in zip(va, y[va], p)
                    )

            print(
                f"Repeat seed {seed}, fold {fold}/5 finished",
                flush=True,
            )

        pd.DataFrame(predictions).to_csv(
            OUT / "repeated_oof_predictions.csv",
            index=False,
        )

    pred = pd.DataFrame(predictions)
    repeat_rows = []

    for (seed, name, scenario), d in pred.groupby(
        ["repeat_seed", "model", "scenario"],
        sort=False,
    ):
        assert len(d) == 272
        assert d.formulation_id.nunique() == 272
        assert set(d.formulation_id).isdisjoint(test.formulation_id)

        repeat_rows.append({
            "repeat_seed": seed,
            "model": name,
            "scenario": scenario,
            **metrics(d.actual, d.predicted),
        })

    repeated = pd.DataFrame(repeat_rows)
    repeated.to_csv(OUT / "repeated_metrics.csv", index=False)

    repeat_summary = []

    for name in NAMES:
        d = repeated[repeated.model == name]
        base = d[d.scenario == MAIN[0]].set_index("repeat_seed")
        aug = d[d.scenario == MAIN[1]].set_index("repeat_seed")

        row = {
            "model": name,
            "improved_repeats": int(
                (aug.RMSE < base.RMSE).sum()
            ),
        }

        for metric in ["RMSE", "MAE"]:
            comparisons = [
                ("original", base[metric]),
                ("augmented", aug[metric]),
                ("delta", aug[metric] - base[metric]),
            ]

            for label, values in comparisons:
                row[f"{metric}_{label}_mean"] = float(values.mean())
                row[f"{metric}_{label}_sd"] = float(
                    values.std(ddof=1)
                )

        repeat_summary.append(row)

    pd.DataFrame(repeat_summary).to_csv(
        OUT / "repeated_summary.csv",
        index=False,
    )
    save_json(OUT / "repeated_hyperparameters.json", parameters)

    # --------------------------------------------------------
    # Acquisition-proxy group validation
    # --------------------------------------------------------

    groups = train.batch.to_numpy()
    group_predictions = []
    group_parameters = []

    for k, held in enumerate(pd.unique(groups), start=1):
        tr = np.flatnonzero(groups != held)
        va = np.flatnonzero(groups == held)

        assert set(groups[tr]).isdisjoint(groups[va])

        inner = GroupKFold(
            n_splits=len(np.unique(groups[tr]))
        )

        for name in NAMES:
            for scenario, sigma in zip(MAIN, [None, 0.03]):
                estimator, grid = specs()[name]

                if sigma is not None:
                    estimator = AugmentedRegressor(
                        estimator,
                        sigma=sigma,
                        seed=3026 + k,
                    )
                    grid = {
                        "estimator__" + key: values
                        for key, values in grid.items()
                    }

                search = GridSearchCV(
                    estimator,
                    grid,
                    cv=inner,
                    scoring="neg_root_mean_squared_error",
                    n_jobs=1,
                    refit=True,
                    error_score="raise",
                )

                search.fit(
                    X[tr],
                    y[tr],
                    groups=groups[tr],
                )

                p = search.predict(X[va])

                group_parameters.append({
                    "held_group": str(held),
                    "model": name,
                    "scenario": scenario,
                    "parameters": {
                        key: str(value)
                        for key, value in search.best_params_.items()
                    },
                })

                group_predictions.extend(
                    {
                        "held_group": str(held),
                        "model": name,
                        "scenario": scenario,
                        "formulation_id": train.iloc[i].formulation_id,
                        "actual": float(actual),
                        "predicted": float(predicted),
                    }
                    for i, actual, predicted in zip(va, y[va], p)
                )

        print(
            "Acquisition proxy held group finished:",
            held,
            flush=True,
        )

    group_pred = pd.DataFrame(group_predictions)
    group_pred.to_csv(
        OUT / "group_oof_predictions.csv",
        index=False,
    )

    group_metrics = []

    for (name, scenario), d in group_pred.groupby(
        ["model", "scenario"],
        sort=False,
    ):
        assert len(d) == 272
        assert d.formulation_id.nunique() == 272

        group_metrics.append({
            "model": name,
            "scenario": scenario,
            **metrics(d.actual, d.predicted),
        })

    pd.DataFrame(group_metrics).to_csv(
        OUT / "group_metrics.csv",
        index=False,
    )
    save_json(OUT / "group_hyperparameters.json", group_parameters)

    # --------------------------------------------------------
    # Composition proximity
    # --------------------------------------------------------

    distance = 0.5 * cdist(
        test[FEATURES].to_numpy(float),
        X,
        metric="cityblock",
    )

    nearest = distance.min(axis=1)
    nearest_index = distance.argmin(axis=1)

    train_distance = 0.5 * cdist(X, X, metric="cityblock")
    np.fill_diagonal(train_distance, np.inf)
    leave_one_out = train_distance.min(axis=1)

    pd.DataFrame({
        "test_id": test.formulation_id,
        "nearest_train_id": (
            train.iloc[nearest_index].formulation_id.to_numpy()
        ),
        "total_variation_distance": nearest,
    }).to_csv(
        OUT / "test_nearest_training.csv",
        index=False,
    )

    similarity_audit = {
        "test_nearest_median": float(np.median(nearest)),
        "test_nearest_q1": float(np.quantile(nearest, 0.25)),
        "test_nearest_q3": float(np.quantile(nearest, 0.75)),
        "train_loo_median": float(np.median(leave_one_out)),
        "test_nearest_min": float(nearest.min()),
        "test_nearest_max": float(nearest.max()),
        "test_within_001": int((nearest <= 0.01).sum()),
        "test_within_005": int((nearest <= 0.05).sum()),
        "exact_train_test_duplicates": int(
            (nearest < 1e-12).sum()
        ),
        "counts_by_group": {
            str(group): {
                "train": int((train.batch == group).sum()),
                "test": int((test.batch == group).sum()),
            }
            for group in pd.unique(
                pd.concat([train.batch, test.batch])
            )
        },
    }

    save_json(OUT / "similarity_audit.json", similarity_audit)

    # --------------------------------------------------------
    # Conditional paired bootstrap of existing test predictions
    # --------------------------------------------------------

    test_predictions = pd.read_csv(
        ROOT / "results/test_predictions.csv"
    )

    rng = np.random.default_rng(4026)
    bootstrap_indices = rng.integers(
        0,
        len(test),
        size=(10000, len(test)),
    )

    bootstrap_rows = []

    for name in NAMES:
        base = (
            test_predictions[
                (test_predictions.model == name)
                & (test_predictions.scenario == MAIN[0])
            ]
            .set_index("formulation_id")
            .loc[test.formulation_id]
        )

        aug = (
            test_predictions[
                (test_predictions.model == name)
                & (test_predictions.scenario == MAIN[1])
            ]
            .set_index("formulation_id")
            .loc[test.formulation_id]
        )

        assert np.allclose(base.actual, aug.actual)

        e0 = base.predicted.to_numpy() - base.actual.to_numpy()
        e1 = aug.predicted.to_numpy() - aug.actual.to_numpy()

        deltas = (
            np.sqrt(np.mean(e1[bootstrap_indices] ** 2, axis=1))
            - np.sqrt(np.mean(e0[bootstrap_indices] ** 2, axis=1))
        )

        lower, upper = np.quantile(deltas, [0.025, 0.975])

        bootstrap_rows.append({
            "model": name,
            "delta_RMSE": float(
                np.sqrt(np.mean(e1 ** 2))
                - np.sqrt(np.mean(e0 ** 2))
            ),
            "conditional_CI_lower": float(lower),
            "conditional_CI_upper": float(upper),
        })

    pd.DataFrame(bootstrap_rows).to_csv(
        OUT / "conditional_bootstrap.csv",
        index=False,
    )

