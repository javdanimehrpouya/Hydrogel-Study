# ============================================================
# Download and verify frozen public data
# ============================================================

def prepare_data():
    tables = {}
    manifest = []

    for n in [180, 289, 316, 341]:
        relative = f"data/df_{n}.csv"
        path = ROOT / relative
        url = BASE + relative

        if not path.exists():
            print(f"Downloading {relative}", flush=True)
            with urllib.request.urlopen(url, timeout=90) as response:
                path.write_bytes(response.read())

        digest = hashlib.sha256(path.read_bytes()).hexdigest()
        if digest != SOURCE_HASHES[n]:
            raise RuntimeError(f"Source hash mismatch: {relative}")

        tables[n] = pd.read_csv(path, index_col=0)
        manifest.append({
            "file": relative,
            "url": url,
            "sha256": digest,
        })

    save_json(ROOT / "data/source_manifest.json", manifest)

    def keys(frame):
        return list(
            map(tuple, frame[FEATURES].round(8).to_numpy())
        )

    sets = {
        n: set(keys(frame))
        for n, frame in tables.items()
    }

    assert sets[180] < sets[289] < sets[316] < sets[341]

    source = tables[341]

    rounds = [
        next(
            j
            for j, n in enumerate([180, 289, 316, 341])
            if composition in sets[n]
        )
        for composition in keys(source)
    ]

    order = np.argsort(rounds, kind="stable")
    clean = source.iloc[order].copy()

    response_mapping = dict(zip(keys(clean), clean[TARGET]))

    for frame in tables.values():
        assert np.allclose(
            [response_mapping[k] for k in keys(frame)],
            frame[TARGET],
        )

    clean.insert(
        0,
        "formulation_id",
        [f"F{i + 1:03d}" for i in clean.index],
    )
    clean.insert(1, "source_row_index", clean.index)

    # Snapshot membership is an acquisition proxy, not a verified lab batch.
    clean["batch"] = np.select(
        [
            np.arange(341) < 180,
            np.arange(341) < 289,
            np.arange(341) < 316,
        ],
        ["Initial", "Round 1", "Round 2"],
        default="Round 3",
    )

    X = clean[FEATURES].to_numpy(float)
    y = clean[TARGET].to_numpy(float)

    assert len(clean) == 341
    assert np.isfinite(X).all()
    assert np.isfinite(y).all()
    assert (X >= 0).all()
    assert np.allclose(X.sum(axis=1), 1)
    assert not clean[FEATURES].round(8).duplicated().any()

    clean.to_csv(
        ROOT / "data/clean_formulations.csv",
        index=False,
    )

    print(
        "Verified four snapshots and reconstructed "
        "341 unique real formulations.",
        flush=True,
    )


# ============================================================
# Constrained compositional augmentation
# ============================================================

def perturb(X, sigma=0.03, seed=2026, cap=0.01):
    """
    Generate one child per parent.

    1. Gaussian log perturbation.
    2. Closure to unit sum.
    3. Radial contraction if a component changes by more than cap.

    Existing zeros remain zero.
    sigma is a modeling choice, not measured instrument error.
    cap=0.01 means one molar percentage point.
    """
    X = np.asarray(X, dtype=float)

    epsilon = np.random.default_rng(seed).normal(
        0,
        sigma,
        X.shape,
    )

    raw = X * np.exp(epsilon)
    raw /= raw.sum(axis=1, keepdims=True)

    delta = raw - X
    peak = np.abs(delta).max(axis=1, keepdims=True)

    shrink = np.minimum(
        1,
        cap / np.maximum(peak, 1e-15),
    )

    child = X + delta * shrink

    assert np.allclose(child.sum(axis=1), 1, atol=1e-12)
    assert (child >= 0).all()
    assert np.array_equal(child == 0, X == 0)
    assert np.abs(child - X).max() <= cap + 1e-12

    return child


class AugmentedRegressor(RegressorMixin, BaseEstimator):
    """
    Augmentation occurs inside fit().

    GridSearchCV therefore generates children only from the real
    fitting rows in each inner fold.
    """

    def __init__(self, estimator, sigma=0.03, seed=2026):
        self.estimator = estimator
        self.sigma = sigma
        self.seed = seed

    def fit(self, X, y):
        X = np.asarray(X, dtype=float)
        y = np.asarray(y, dtype=float)

        child = perturb(
            X,
            sigma=self.sigma,
            seed=self.seed,
        )

        self.estimator_ = clone(self.estimator).fit(
            np.vstack([X, child]),
            np.r_[y, y],
        )

        self.n_features_in_ = X.shape[1]
        return self

    def predict(self, X):
        return self.estimator_.predict(X)


# ============================================================
# Inner and final hyperparameter tuning
# ============================================================

def tune(name, X, y, seed, sigma=None):
    estimator, grid = specs()[name]

    if sigma is not None:
        estimator = AugmentedRegressor(
            estimator,
            sigma=sigma,
            seed=seed,
        )
        grid = {
            "estimator__" + key: values
            for key, values in grid.items()
        }

    cv = KFold(
        n_splits=3,
        shuffle=True,
        random_state=seed,
    )

    search = GridSearchCV(
        estimator,
        grid,
        cv=cv,
        scoring="neg_root_mean_squared_error",
        n_jobs=1,
        refit=True,
        error_score="raise",
    )

    search.fit(X, y)

    parameters = {
        key: str(value)
        for key, value in search.best_params_.items()
    }

    return search.best_estimator_, parameters


def final_tune(name, X, y, sigma):
    estimator, grid = specs()[name]

    if sigma is not None:
        estimator = AugmentedRegressor(
            estimator,
            sigma=sigma,
            seed=SEED,
        )
        grid = {
            "estimator__" + key: values
            for key, values in grid.items()
        }

    search = GridSearchCV(
        estimator,
        grid,
        cv=KFold(
            n_splits=5,
            shuffle=True,
            random_state=SEED,
        ),
        scoring="neg_root_mean_squared_error",
        n_jobs=1,
        refit=True,
        error_score="raise",
    )

    search.fit(X, y)

    parameters = {
        key: str(value)
        for key, value in search.best_params_.items()
    }

    return search.best_estimator_, parameters


# ============================================================
# Original analysis: 80/20 split and nested five-fold CV
# ============================================================

def run_study():
    start = time.time()

    df = pd.read_csv(ROOT / "data/clean_formulations.csv")

    train_idx, test_idx = train_test_split(
        np.arange(len(df)),
        test_size=0.2,
        random_state=SEED,
        shuffle=True,
    )

    # Preserve the original ordering for subsequent fold assignments.
    train_idx = np.sort(train_idx)
    test_idx = np.sort(test_idx)

    assert len(train_idx) == 272
    assert len(test_idx) == 69
    assert set(train_idx).isdisjoint(test_idx)

    Xall = df[FEATURES].to_numpy(float)
    yall = df[TARGET].to_numpy(float)

    train = df.iloc[train_idx].reset_index(drop=True)
    hold = df.iloc[test_idx].reset_index(drop=True)

    train.to_csv(ROOT / "data/train_real_272.csv", index=False)
    hold.to_csv(ROOT / "data/test_real_69.csv", index=False)

    X = Xall[train_idx]
    y = yall[train_idx]

    split = df[["formulation_id", "batch"]].copy()
    split["split"] = "train"
    split.loc[test_idx, "split"] = "test"
    split.to_csv(ROOT / "data/split_manifest.csv", index=False)

    rows = []
    predictions = []
    parameters = []
    fold_assignments = []
    children = []

    outer = KFold(
        n_splits=5,
        shuffle=True,
        random_state=SEED,
    )

    for fold, (tr, va) in enumerate(outer.split(X), start=1):
        fold_seed = SEED + fold

        assert set(tr).isdisjoint(va)
        assert set(train_idx[np.r_[tr, va]]).isdisjoint(test_idx)

        fold_assignments.extend(
            {
                "formulation_id": train.iloc[i].formulation_id,
                "validation_fold": fold,
            }
            for i in va
        )

        child = perturb(X[tr], sigma=0.03, seed=fold_seed)

        for i, composition in zip(tr, child):
            children.append({
                "fold": fold,
                "parent_id": train.iloc[i].formulation_id,
                "origin": "synthetic_training_only",
                "inherited_target": float(y[i]),
                **dict(zip(FEATURES, composition)),
                "max_component_change": float(
                    np.abs(composition - X[i]).max()
                ),
            })

        for name in NAMES:
            baseline, baseline_parameters = tune(
                name, X[tr], y[tr], fold_seed
            )
            augmented, augmented_parameters = tune(
                name, X[tr], y[tr], fold_seed, sigma=0.03
            )

            fitted = {
                MAIN[0]: baseline,
                MAIN[1]: augmented,

                # Same baseline parameters, plus perturbation.
                "Jitter 0.03 fixed baseline": AugmentedRegressor(
                    clone(baseline),
                    sigma=0.03,
                    seed=fold_seed,
                ).fit(X[tr], y[tr]),

                # Duplicate parents without perturbing their compositions.
                "Duplicate control": AugmentedRegressor(
                    clone(baseline),
                    sigma=0,
                    seed=fold_seed,
                ).fit(X[tr], y[tr]),

                # Retain parameters selected at sigma=0.03.
                "Jitter 0.01 sensitivity": AugmentedRegressor(
                    clone(augmented.estimator),
                    sigma=0.01,
                    seed=fold_seed,
                ).fit(X[tr], y[tr]),

                "Jitter 0.05 sensitivity": AugmentedRegressor(
                    clone(augmented.estimator),
                    sigma=0.05,
                    seed=fold_seed,
                ).fit(X[tr], y[tr]),
            }

            parameters.append({
                "fold": fold,
                "model": name,
                "baseline": baseline_parameters,
                "augmented": augmented_parameters,
            })

            for scenario, model in fitted.items():
                p = model.predict(X[va])

                rows.append({
                    "fold": fold,
                    "model": name,
                    "scenario": scenario,
                    "n_train_real": len(tr),
                    "n_train_synthetic": (
                        0 if scenario == MAIN[0] else len(tr)
                    ),
                    "n_validation_real": len(va),
                    **metrics(y[va], p),
                })

                predictions.extend(
                    {
                        "fold": fold,
                        "model": name,
                        "scenario": scenario,
                        "formulation_id": train.iloc[i].formulation_id,
                        "actual": float(actual),
                        "predicted": float(predicted),
                    }
                    for i, actual, predicted in zip(va, y[va], p)
                )

            print(
                f"Fold {fold}/5 | {name} | "
                f"RMSE original={rows[-6]['RMSE']:.3f}, "
                f"augmented={rows[-5]['RMSE']:.3f}",
                flush=True,
            )

        # Save intermediate results after every completed outer fold.
        pd.DataFrame(rows).to_csv(
            ROOT / "results/cv_fold_metrics.csv",
            index=False,
        )
        pd.DataFrame(predictions).to_csv(
            ROOT / "results/cv_oof_predictions.csv",
            index=False,
        )

    pd.DataFrame(fold_assignments).to_csv(
        ROOT / "data/train_cv_assignments.csv",
        index=False,
    )
    pd.DataFrame(children).to_csv(
        ROOT / "data/cv_synthetic_audit.csv",
        index=False,
    )
    save_json(
        ROOT / "results/cv_hyperparameters.json",
        parameters,
    )

    folds = pd.DataFrame(rows)
    oof = pd.DataFrame(predictions)

    summary_rows = []

    for (name, scenario), d in oof.groupby(
        ["model", "scenario"],
        sort=False,
    ):
        assert len(d) == 272
        assert d.formulation_id.nunique() == 272
        assert set(d.formulation_id).isdisjoint(hold.formulation_id)

        f = folds[
            (folds.model == name)
            & (folds.scenario == scenario)
        ]

        summary_rows.append({
            "model": name,
            "scenario": scenario,
            **metrics(d.actual, d.predicted),
            **{
                metric + "_fold_mean": float(f[metric].mean())
                for metric in ["RMSE", "MAE", "R2"]
            },
            **{
                metric + "_fold_sd": float(f[metric].std(ddof=1))
                for metric in ["RMSE", "MAE", "R2"]
            },
        })

    summary = pd.DataFrame(summary_rows)
    summary.to_csv(ROOT / "results/cv_summary.csv", index=False)

    # Select before evaluating the holdout.
    ranking = (
        summary[summary.scenario.isin(MAIN)]
        .sort_values("RMSE_fold_mean")
    )

    selected = ranking.iloc[0][
        ["model", "scenario", "RMSE_fold_mean"]
    ].to_dict()

    save_json(
        ROOT / "results/selection_before_test.json",
        selected,
    )

    print("Selected using training CV only:", selected, flush=True)

    fitted_final = {}
    final_parameters = []

    for name in NAMES:
        for scenario, sigma in zip(MAIN, [None, 0.03]):
            model, settings = final_tune(name, X, y, sigma)

            fitted_final[(name, scenario)] = model
            final_parameters.append({
                "model": name,
                "scenario": scenario,
                "parameters": settings,
            })

            suffix = "baseline" if sigma is None else "augmented"
            filename = f"{name.replace(' ', '_')}_{suffix}.joblib"
            joblib.dump(model, ROOT / "models" / filename)

        print("Final tuning completed:", name, flush=True)

    save_json(
        ROOT / "results/final_hyperparameters.json",
        final_parameters,
    )

    # All fitting, tuning and selection have finished.
    test_rows = []
    test_predictions = []

    for (name, scenario), model in fitted_final.items():
        p = model.predict(Xall[test_idx])

        test_rows.append({
            "model": name,
            "scenario": scenario,
            "n_train_real": 272,
            "n_train_synthetic": (
                0 if scenario == MAIN[0] else 272
            ),
            "n_test_real": 69,
            **metrics(yall[test_idx], p),
        })

        test_predictions.extend(
            {
                "model": name,
                "scenario": scenario,
                "formulation_id": df.iloc[i].formulation_id,
                "actual": float(actual),
                "predicted": float(predicted),
            }
            for i, actual, predicted in zip(
                test_idx, yall[test_idx], p
            )
        )

    tests = pd.DataFrame(test_rows)
    tests.to_csv(ROOT / "results/test_metrics.csv", index=False)

    pd.DataFrame(test_predictions).to_csv(
        ROOT / "results/test_predictions.csv",
        index=False,
    )

    final_child = perturb(X, sigma=0.03, seed=SEED)

    expanded = pd.DataFrame(
        np.vstack([X, final_child]),
        columns=FEATURES,
    )
    expanded["inherited_or_measured_target"] = np.r_[y, y]
    expanded["parent_id"] = list(train.formulation_id) * 2
    expanded["origin"] = ["real"] * 272 + ["synthetic"] * 272

    expanded.to_csv(
        ROOT / "data/final_augmented_training_544.csv",
        index=False,
    )

    comparison = []

    for name in NAMES:
        s = summary[summary.model == name].set_index("scenario")
        t = tests[tests.model == name].set_index("scenario")

        f = folds[folds.model == name].pivot(
            index="fold",
            columns="scenario",
            values="RMSE",
        )

        comparison.append({
            "model": name,
            "cv_RMSE_before": s.loc[MAIN[0], "RMSE"],
            "cv_RMSE_after": s.loc[MAIN[1], "RMSE"],
            "test_RMSE_before": t.loc[MAIN[0], "RMSE"],
            "test_RMSE_after": t.loc[MAIN[1], "RMSE"],
            "test_improvement_pct": 100 * (
                1
                - t.loc[MAIN[1], "RMSE"]
                / t.loc[MAIN[0], "RMSE"]
            ),
            "cv_improved_folds": int(
                (f[MAIN[1]] < f[MAIN[0]]).sum()
            ),
        })

    pd.DataFrame(comparison).to_csv(
        ROOT / "results/comparison.csv",
        index=False,
    )

    import sklearn
    import xgboost
    import catboost

    protocol = {
        "seed": SEED,
        "n_actual": 341,
        "n_train": 272,
        "n_test": 69,
        "outer_cv_folds": 5,
        "inner_tuning_folds": 3,
        "final_tuning_folds": 5,
        "hyperparameter_configurations_per_model": 6,
        "sigma": 0.03,
        "sensitivity": [0.01, 0.05],
        "component_change_cap": 0.01,
        "children_per_training_parent": 1,
        "target_noise": False,
        "feature_selection": False,
        "features": FEATURES,
        "target": TARGET,
        "selection": selected,
        "holdout_note": (
            "Retrospective random holdout. Excluded from fitting "
            "and selection in this run. Dataset explored previously."
        ),
        "sensitivity_note": (
            "Sensitivity retains parameters selected at sigma 0.03; "
            "not independently tuned."
        ),
        "mean_baseline_test": metrics(
            yall[test_idx],
            np.full(len(test_idx), y.mean()),
        ),
        "noise_max_abs_fraction": float(
            np.abs(final_child - X).max()
        ),
        "noise_median_max_abs_fraction": float(
            np.median(np.abs(final_child - X).max(axis=1))
        ),
        "synthetic_are_new_experiments": False,
        "elapsed_seconds": time.time() - start,
        "source_clean_sha256": hashlib.sha256(
            (ROOT / "data/clean_formulations.csv").read_bytes()
        ).hexdigest(),
        "versions": {
            "python": platform.python_version(),
            "numpy": np.__version__,
            "pandas": pd.__version__,
            "scikit-learn": sklearn.__version__,
            "xgboost": xgboost.__version__,
            "catboost": catboost.__version__,
        },
    }

    save_json(ROOT / "results/protocol.json", protocol)

    print(tests.to_string(index=False), flush=True)
    print(
        "Main analysis elapsed seconds:",
        round(time.time() - start, 1),
        flush=True,
    )


